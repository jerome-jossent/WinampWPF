<Window x:Class="WinampWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WinampWPF.Views"

        Title="{Binding ApplicationName}"

        Width="450"
        Height="250"

        WindowStyle="None"
        BorderBrush="Black"
        BorderThickness="5"

        Background="#101010">

        <!--ResizeMode="CanResizeWithGrip"-->
        <!--Height="202"-->
        <!--SizeToContent="WidthAndHeight"-->
        <!--ResizeMode="CanMinimize"-->
        
    <Grid Margin="0">
        <views:PlayerView
            DataContext="{Binding Player}"/>

        <Button Width="30" Height="35" Margin="4"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Right"
                Content="▤" FontSize="20"
                Click="PlaylistToggle_Click"
                />

        <!-- close -->
        <Button Grid.Column="0" Content="Close" FontSize="20" Click="Close_Click" 
                            HorizontalAlignment="Left" VerticalAlignment="Top" Width="20" Height="20" Margin="4">
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Image Stretch="Uniform" Source="/Resources/croix.png"></Image>
                </ControlTemplate>
            </Button.Template>
        </Button>
        
    </Grid>
</Window>