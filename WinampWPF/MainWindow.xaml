<Window x:Class="WinampWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WinampWPF.Views"

        Title="{Binding ApplicationName}"

        Width="{Binding WindowWidth}"
        Height="{Binding WindowHeight}"

        Left="{Binding WindowLeft}"
        Top="{Binding WindowTop}"

        MinWidth="950" MinHeight="600"

        WindowStyle="SingleBorderWindow"
        BorderBrush="Black"
        BorderThickness="5"
        
        Background="#101010">

    <Grid Margin="0">

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <views:PlayerView
            Grid.Row="0"
            DataContext="{Binding Player}"/>

        <views:PlaylistView
            Grid.Row="2"
            DataContext="{Binding Playlist}"/>
    </Grid>
</Window>